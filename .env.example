# Copy this file to .env and fill in your Supabase project details.
# You can also paste these values directly into the app's Setup screen.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# OTA update source. Defaults to the GitHub gh-pages branch of this repository.
# Point this at your Vercel deployment URL if you prefer to host updates there.
VITE_UPDATE_URL=https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/gh-pages
